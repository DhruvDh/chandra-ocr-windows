+#ifndef GGML_SYCL_FATTN_ONEDNN_VISION_HPP
+#define GGML_SYCL_FATTN_ONEDNN_VISION_HPP
+
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+#include "oneapi/dnnl/dnnl_graph_sycl.hpp"
+
+// Experimental unmasked attention only. Public Graph allocators bound internal
+// tensors; they do not identify the compiled implementation or bound driver/JIT
+// memory. Keep the ordinary masked engine and allocator unchanged.
+namespace ggml_sycl_vision_sdpa {
+
+static constexpr size_t max_allocation_bytes = 64ull << 20;
+static constexpr size_t max_live_bytes       = 128ull << 20;
+
+struct allocation {
+    size_t bytes;
+    sycl::context context;
+};
+
+struct allocator_state {
+    std::mutex mutex;
+    std::unordered_map<void *, allocation> allocations;
+    std::vector<sycl::queue> queues;
+    size_t live_bytes = 0;
+};
+
+static allocator_state & state() {
+    // oneDNN may retain callbacks in its own caches beyond our cache teardown.
+    // This small state intentionally lasts until the owned worker exits. The
+    // experiment does not support unloading the backend DLL inside a process.
+    static auto * retained = new allocator_state;
+    return *retained;
+}
+
+static void * allocate(size_t bytes, size_t alignment, const void * dev, const void * context) noexcept {
+    try {
+        auto & s = state();
+        const size_t charged = bytes == 0 ? 1 : bytes;
+        {
+            std::lock_guard<std::mutex> lock(s.mutex);
+            if (charged > max_allocation_bytes || charged > max_live_bytes - s.live_bytes) {
+                GGML_ABORT("[VISION-SDPA] denied Graph allocation: request=%zu live=%zu limits=%zu/%zu; refusing possible quadratic fallback",
+                           charged, s.live_bytes, max_allocation_bytes, max_live_bytes);
+            }
+            s.live_bytes += charged;
+        }
+        // oneDNN's default SYCL allocator treats alignment 0 as 64.
+        if (alignment == 0) {
+            alignment = 64;
+        }
+        void * ptr = sycl::aligned_alloc_device(alignment, charged,
+                *static_cast<const sycl::device *>(dev), *static_cast<const sycl::context *>(context));
+        if (!ptr) {
+            GGML_ABORT("[VISION-SDPA] device allocation failed: %zu bytes", charged);
+        }
+        {
+            std::lock_guard<std::mutex> lock(s.mutex);
+            if (!s.allocations.emplace(ptr, allocation{charged, *static_cast<const sycl::context *>(context)}).second) {
+                GGML_ABORT("[VISION-SDPA] duplicate allocation identity");
+            }
+        }
+        return ptr;
+    } catch (...) {
+        // Do not throw through a C callback or return nullptr to an unchecked
+        // library scratchpad path. The finite experiment must fail closed.
+        GGML_ABORT("[VISION-SDPA] Graph allocator failed");
+    }
+}
+
+static void deallocate(void * ptr, const void * dev, const void * context, void * event) noexcept {
+    if (!ptr) {
+        return;
+    }
+    try {
+        auto & s = state();
+        const auto & device = *static_cast<const sycl::device *>(dev);
+        const auto & ctx    = *static_cast<const sycl::context *>(context);
+        std::vector<sycl::queue> owned_queues;
+        {
+            std::lock_guard<std::mutex> lock(s.mutex);
+            auto it = s.allocations.find(ptr);
+            if (it == s.allocations.end() || it->second.context != ctx) {
+                GGML_ABORT("[VISION-SDPA] unknown allocation/context during release");
+            }
+            for (const auto & queue : s.queues) {
+                if (queue.get_device() == device && queue.get_context() == ctx) {
+                    owned_queues.push_back(queue);
+                }
+            }
+        }
+        if (owned_queues.empty()) {
+            GGML_ABORT("[VISION-SDPA] no registered execution queue during release");
+        }
+        if (event) {
+            static_cast<sycl::event *>(event)->wait_and_throw();
+        }
+        // oneDNN can unwind after a partial submission before recording its
+        // final event. Drain the actual candidate queues before releasing USM.
+        // This conservative synchronization is part of the measured candidate.
+        for (auto & queue : owned_queues) {
+            queue.wait_and_throw();
+        }
+        // Never hold the accounting lock across a queue/event wait. Keep bytes
+        // charged until free completes; serialize pointer reuse with the map.
+        std::lock_guard<std::mutex> lock(s.mutex);
+        auto it = s.allocations.find(ptr);
+        if (it == s.allocations.end()) {
+            GGML_ABORT("[VISION-SDPA] duplicate release");
+        }
+        sycl::free(ptr, ctx);
+        s.live_bytes -= it->second.bytes;
+        s.allocations.erase(it);
+    } catch (...) {
+        GGML_ABORT("[VISION-SDPA] Graph allocation release/completion failed");
+    }
+}
+
+static dnnl::engine get_engine(sycl::queue & queue) {
+    auto & s = state();
+    {
+        std::lock_guard<std::mutex> lock(s.mutex);
+        bool known = false;
+        for (const auto & registered : s.queues) {
+            known = known || registered == queue;
+        }
+        if (!known) {
+            s.queues.push_back(queue);
+        }
+    }
+    struct entry {
+        sycl::device device;
+        sycl::context context;
+        dnnl::engine engine;
+    };
+    static std::mutex engine_mutex;
+    static std::vector<entry> engines;
+    std::lock_guard<std::mutex> lock(engine_mutex);
+    const auto device = queue.get_device();
+    const auto context = queue.get_context();
+    for (const auto & cached : engines) {
+        if (cached.device == device && cached.context == context) {
+            return cached.engine;
+        }
+    }
+    auto allocator = dnnl::graph::sycl_interop::make_allocator(allocate, deallocate);
+    auto engine = dnnl::graph::sycl_interop::make_engine_with_allocator(device, context, allocator);
+    engines.push_back({device, context, engine});
+    GGML_LOG_INFO("[VISION-SDPA] experimental unmasked Graph engine; allocation limits=%zu/%zu bytes; fused implementation must be verified separately\n",
+                  max_allocation_bytes, max_live_bytes);
+    return engine;
+}
+
+} // namespace ggml_sycl_vision_sdpa
+
+#endif
